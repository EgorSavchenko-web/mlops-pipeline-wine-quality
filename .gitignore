# Artefacts regenerated by every pipeline run. They are deliberately not
# tracked: the raw data in data/raw/ plus the code is enough to reproduce them,
# and a 4 MB model rewritten every five minutes would bury the git history.
#
# Every pattern below is anchored with a leading slash. Without it, `models/`
# matches a directory of that name at ANY depth - including code/models/ -
# which silently drops the entire model-engineering stage from the repository.
# The two directories below are kept in the repository as empty placeholders
# (a .gitkeep each) so that the layout matches the structure the assignment
# asks for even before the pipeline has produced anything.
/data/processed/*
!/data/processed/.gitkeep
/models/*
!/models/.gitkeep
/mlruns/

# Airflow runtime
/services/airflow/logs/*
!/services/airflow/logs/.gitkeep
airflow.db
airflow.cfg
webserver_config.py
standalone_admin_password.txt

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Working documents, not part of the submitted repository
/PLAN.md
/PROJECT_MEMORY.md
/PMLDL Assignment 1_ Deployment.md
/_to_delete/
